{
  "name": "coldchain-ai",
  "version": "3.3.0",
  "description": "ColdChain AI — Soğuk Zincir İade Otomasyon Sistemi",
  "main": "main.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "dev:ui": "node scripts/build-ui.js --watch",
    "prestart": "npm run build:ui",
    "start": "node --use-system-ca server.js",
    "preapp": "npm run build:ui",
    "app": "electron .",
    "prebuild": "npm run build:ui",
    "build": "electron-builder",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "appId": "com.hukudok.coldchain",
    "productName": "Soguk Zincir Otomasyon",
    "files": [
      "main.js",
      "server.js",
      "database.js",
      "auth.js",
      "gemini-client.js",
      "pdf-helper.js",
      "date-format-detector.js",
      "app.html",
      "js/**/*",
      "ui/*.js",
      "web/**/*",
      "package.json",
      "!ui/*.jsx",
      "!tests/**",
      "!scripts/**",
      "!**/*.md",
      "!.env*",
      "!*.db*",
      "!audit.key",
      "!audit.head.json",
      "!backups/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
