# ColdChain AI — ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizi girin — ya da hiç
# uğraşmayın: uygulama içindeki Ayarlar ekranı bu dosyayı sizin için yazar
# (anahtar, model, fiyat/kur). Paketli kurulumda dosya userData klasöründedir.

# Google Gemini API anahtarı (OCR ve yeni PDF formatları için) — https://aistudio.google.com/apikey
# Anahtar yoksa uygulama yine açılır; Excel/CSV ve öğrenilmiş şablonlar AI'sız çalışır.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Kullanılacak model (opsiyonel)
GEMINI_MODEL=gemini-2.5-flash

# Sunucu portu (opsiyonel)
PORT=3000

# Dinlenecek adres (opsiyonel) — varsayılan yalnızca bu bilgisayar (127.0.0.1).
# LAN'daki başka bilgisayarlardan erişim gerekiyorsa 0.0.0.0 (kimlik doğrulama YOK — dikkat).
# HOST=127.0.0.1

# OCR paralelliği: aynı anda işlenen PDF parçası (1–4, varsayılan 2)
# EXTRACT_CONCURRENCY=2

# Gemini istek zaman aşımı (ms, en az 30000; varsayılan 180000)
# GEMINI_TIMEOUT_MS=180000

# Kimlik doğrulama: kullanıcılar veritabanında (users tablosu), ilk çalıştırmada
# arayüz ilk yöneticiyi oluşturur. Denetim zinciri imza anahtarı: audit.key
# (userData; paketli kurulumda %APPDATA%\Soguk Zincir Otomasyon\). Bu dosyayı yedekleyin.

# Fiyat/kur override (opsiyonel) — boş bırakılırsa model tablosundan alınır
# PRICE_INPUT_PER_M=0.10
# PRICE_OUTPUT_PER_M=0.40
# USD_TRY_RATE=39
